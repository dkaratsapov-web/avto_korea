# Telegram Bot API — отправка заявок менеджеру.
# TODO: запросить у заказчика токен бота и chat_id.
# Бот создаётся через @BotFather, chat_id можно узнать через @userinfobot
# или getUpdates. Пока значения пустые — заявки логируются в консоль сервера.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Публичный адрес сайта (для sitemap/robots/OG). По умолчанию — продакшен-домен.
# TODO: подтвердить итоговый домен у заказчика.
NEXT_PUBLIC_SITE_URL=https://diauto69.ru
