# ──────────────────────────────────────────────────────────────
# ДиАвто69 (React + Vite) — переменные окружения
# Скопируйте в .env.local. Префикс VITE_ обязателен, иначе переменная
# не попадёт в клиентский бандл. Файлы .env* не коммитим.
# ──────────────────────────────────────────────────────────────

# Публичный адрес сайта (для метаданных). По умолчанию — продакшен-домен.
VITE_SITE_URL=https://автоимпорт-69.рф

# Эндпоинт приёма заявок с форм (бэкенд / serverless-функция / Telegram-прокси).
# Пока не задан — формы работают в демо-режиме (показывают успех без отправки).
# TODO: подключить, когда определимся, как принимать лиды (Telegram / e-mail / CRM).
# VITE_LEAD_ENDPOINT=https://example.com/api/lead

# base-путь сборки (для деплоя под подпапкой, напр. GitHub Pages). На корневом домене не нужен.
# VITE_BASE=/avto_korea/
